# Copy to server/.env and fill in. Never commit the real file.

# Solana
RPC_URL=https://api.devnet.solana.com
# Signing keys: either put keys/admin.json, keys/attestor.json, keys/ramp.json in the repo root,
# or paste each key's JSON array (or base58 secret) here. Hosted deploys use these.
# ADMIN_KEY=
# ATTESTOR_KEY=
# RAMP_KEY=

# Server
PORT=8787
KES_PER_USD=129
# Demo visa/salary proofs and minute-long deadlines. Set to false for real use.
DEMO_MODE=true
# Password for /admin and for demo proofs. Long and random.
ADMIN_TOKEN=
# Key for the onchain hash of the seeker's phone number. Long and random; never change it once used.
SEEKER_REF_SECRET=
# SQLite file for job terms, payments and proofs. Must be on a persistent disk when hosted.
# DB_PATH=/var/data/kazisafe.db

# M-Pesa (Safaricom Daraja). Leave empty to run M-Pesa in mock mode.
# DARAJA_ENV=sandbox
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=174379
# DARAJA_PASSKEY=
# DARAJA_CALLBACK_URL=https://your-server.example/api/mpesa/callback
